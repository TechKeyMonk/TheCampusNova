# ==============================================================================
# TheCampusNova Environment Configuration Example
# Copy this file to .env and provide your secret credentials.
# ==============================================================================

# Resend API Key for real email OTP delivery (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email identity configured in your Resend Dashboard
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Sender display name
SENDER_NAME=TheCampusNova Verification

# Flask secret key for secure session token signing
FLASK_SECRET_KEY=change_this_to_a_random_32_byte_secret_key

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campnova
PGHOST=localhost
PGPORT=5432
PGDATABASE=campnova
PGUSER=postgres
PGPASSWORD=postgres

# Translation API Configuration (Optional: Google Cloud Translation API Key; if omitted, deep-translator automatic proxy is used)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Server Host & Port
PORT=8000
HOST=0.0.0.0

