# ==============================================================================
# TheCampusNova Environment Configuration
# Copy this file to .env and configure your environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GMAIL SERVICE CONFIGURATION (Supports Dual Engines: OAuth2 & App Passwords)
# ------------------------------------------------------------------------------
# Official TheCampusNova Gmail sender address
GMAIL_USER=thecampusnova@gmail.com

# OPTION A: Google OAuth2 API Configuration (Recommended for Production Apps in Live Mode)
# Obtain these from Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token_here

# OPTION B: Gmail App Password (Recommended for Permanent Localhost & Reliable Serverless SMTP)
# Generate from https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# 16-character app password (e.g. abcd efgh ijkl mnop)
SMTP_PASS=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thecampusnova@gmail.com
SMTP_USE_TLS=true

# Sender display name
SENDER_NAME=TheCampusNova Verification

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Flask secret key for secure session token and CAPTCHA signing
FLASK_SECRET_KEY=change_this_to_a_random_32_byte_secret_key

# Admin passkey for administrative API routes
ADMIN_PASSKEY=change_this_to_a_secure_admin_passkey

# Server Host & Port
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / Neon / Local)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campnova
PGHOST=localhost
PGPORT=5432
PGDATABASE=campnova
PGUSER=postgres
PGPASSWORD=postgres

# ------------------------------------------------------------------------------
# 4. TRANSLATION API (Optional)
# ------------------------------------------------------------------------------
# Google Cloud Translation API Key (if omitted, automatic multilingual proxy is used)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
